FROM php:8.5-fpm-bookworm@sha256:81b9c405b013ebda0c9b8cd7a1a61424cf3627ca96348d93752a9b0539ce9a25 AS app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS libpq-dev libsqlite3-dev unzip \
    && docker-php-ext-install -j"$(nproc)" bcmath pdo_pgsql pdo_sqlite \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2@sha256:d8f6343d3fae98107426bc49163ccad46ef85aabd4a27d80a74401fab4aba332 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache,sharing=locked \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    COMPOSER_MAX_PARALLEL_HTTP=4 \
    COMPOSER_PROCESS_TIMEOUT=900 \
    composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-progress

COPY . .
RUN mkdir -p bootstrap/cache storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && APP_ENV=build composer dump-autoload --no-dev --no-interaction --classmap-authoritative --no-scripts \
    && APP_ENV=build php artisan package:discover --ansi \
    && chown -R www-data:www-data bootstrap/cache storage

USER www-data

EXPOSE 9000
CMD ["php-fpm", "-F"]

FROM golang:1.26.10-alpine@sha256:5cb67f19c5e7994dcb80c074f7cfca8aeeada45bbdca035f73df269cefdcce61 AS gateway-build

WORKDIR /src
COPY deploy/caddy-build/go.mod deploy/caddy-build/go.sum deploy/caddy-build/main.go ./
RUN go mod tidy \
    && go mod download \
    && go mod verify \
    && CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/caddy .

FROM caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648 AS web

RUN apk upgrade --no-cache

COPY --from=gateway-build /out/caddy /usr/bin/caddy
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=app /var/www/html/public /var/www/html/public

EXPOSE 80 443

FROM golang:1.26.10-alpine@sha256:5cb67f19c5e7994dcb80c074f7cfca8aeeada45bbdca035f73df269cefdcce61 AS minio-client

RUN apk add --no-cache git
WORKDIR /src
RUN git clone --filter=blob:none --no-checkout https://github.com/minio/mc.git . \
    && git checkout --detach 7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
    && test "$(git rev-parse HEAD)" = 7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
    && go get github.com/klauspost/compress@v1.18.7 github.com/prometheus/prometheus@v0.311.3 golang.org/x/net@v0.60.0 google.golang.org/grpc@v1.83.2 \
    && go mod tidy \
    && go mod verify \
    && mc_ldflags="$(go run buildscripts/gen-ldflags.go)" \
    && CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="$mc_ldflags -s -w" -o /out/mc .

FROM postgres:18@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280 AS recovery

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates jq redis-tools \
    && rm -f /usr/local/bin/gosu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=minio-client /out/mc /usr/local/bin/mc
COPY deploy/recovery/qt-recovery /usr/local/bin/qt-recovery
RUN chmod 0555 /usr/local/bin/mc /usr/local/bin/qt-recovery

ENV HOME=/tmp \
    MC_CONFIG_DIR=/tmp/mc \
    MC_QUIET=true

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/qt-recovery"]
