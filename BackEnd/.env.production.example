# Copy this file outside source control, replace every placeholder, and keep permissions owner-only.
APP_HOST=api.erp.example.com
ACME_EMAIL=platform@example.com
APP_KEY=base64:REPLACE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_TIMEZONE=UTC
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_DATABASE=qtfoods
DB_USERNAME=qtfoods_app
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1

AWS_ACCESS_KEY_ID=REPLACE_WITH_DEDICATED_APPLICATION_ACCESS_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_DEDICATED_APPLICATION_STORAGE_SECRET
AWS_BUCKET=qtfoods-evidence-production
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=https://REPLACE_WITH_MANAGED_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_CONNECT_TIMEOUT_SECONDS=2
AWS_REQUEST_TIMEOUT_SECONDS=5

QT_FRONTEND_URL=https://erp.example.com
QT_CORS_ALLOWED_ORIGINS=https://erp.example.com

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Q & T Foods ERP

# Production events require an acknowledged, signed receiver.
QT_OUTBOX_TRANSPORT=http
QT_OUTBOX_HTTP_ENDPOINT=https://REPLACE_WITH_EVENT_RECEIVER_ENDPOINT
QT_OUTBOX_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_OUTBOX_SIGNING_SECRET
QT_OUTBOX_REQUIRE_ACKNOWLEDGEMENT=true
QT_OUTBOX_REQUIRE_BOUND_ACKNOWLEDGEMENT=true
QT_OUTBOX_ACKNOWLEDGED_EVENT_HEADER=X-Acknowledged-Event-ID

QT_ALLOW_DEMO_SEEDERS=false
QT_ALLOW_DEMO_AUTHENTICATION=false
QT_IDENTITY_PREVIEW_LINKS=false
QT_MFA_REQUIRED_ROLES=ERP_ADMIN
QT_AUTH_CHALLENGE_MINUTES=10
QT_LOGIN_OTP_MINUTES=5

# Emergency first-password initialization when mail delivery is unavailable.
# Set all three for the initialization deployment. It intentionally stops before
# serving HTTP; remove all three immediately and redeploy to start the service.
QT_BOOTSTRAP_ADMIN_EMAIL=
QT_BOOTSTRAP_ADMIN_PASSWORD=
QT_BOOTSTRAP_ADMIN_PASSWORD_CONFIRMATION=

# Generate a separate random value of at least 32 characters for metrics scraping.
QT_METRICS_TOKEN=REPLACE_WITH_LONG_RANDOM_METRICS_TOKEN
QT_SLOW_REQUEST_MS=1000
QT_HTTP_METRICS_RETENTION_SECONDS=2592000
QT_READINESS_DATABASE=true
QT_READINESS_REDIS=true
QT_READINESS_OBJECT_STORAGE=true
QT_MONITORED_QUEUES=outbox,default
QT_AUDIT_MONITOR_WINDOW_MINUTES=60
QT_ALERT_FAILED_JOBS_MAX=0
QT_ALERT_OUTBOX_QUARANTINED_MAX=0
QT_ALERT_OUTBOX_RETRY_MAX=20
QT_ALERT_OUTBOX_OLDEST_DUE_SECONDS=300
QT_ALERT_QUEUE_DEPTH_MAX=1000
QT_ALERT_AUDIT_MISSING_CONTEXT_MAX=0

# "log" emits alert-ready JSON to stderr. "http" additionally requires both values below.
QT_ALERT_TRANSPORT=log
QT_ALERT_HTTP_ENDPOINT=
QT_ALERT_SIGNING_SECRET=
QT_ALERT_TIMEOUT_SECONDS=10
QT_ALERT_RENOTIFY_SECONDS=3600

# Absolute host path on approved encrypted/restricted storage. On Linux it must be writable by UID/GID 65532.
QT_BACKUP_HOST_PATH=/srv/qtfoods/backups
QT_BACKUP_RETENTION_DAYS=35
QT_RECOVERY_RPO_MINUTES=1440
QT_RECOVERY_RTO_MINUTES=240
QT_RECOVERY_OBJECT_LIMIT=100000
